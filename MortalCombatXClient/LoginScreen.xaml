<Window x:Class="MortalCombatXClient.LoginScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MortalCombatXClient"
        mc:Ignorable="d"
        Title="LoginScreen" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/mortalkombatwallpaper.jpg"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="98,202,0,0" TextWrapping="Wrap" Text="Username" Foreground="Black" FontSize="12" FontWeight="Medium" VerticalAlignment="Top"/>
        <TextBox x:Name="EnteredText" HorizontalAlignment="Left" Margin="98,217,0,0" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="212" TextChanged="TextBox_TextChanged" Background="Lavender" Height="27"/>
        <Border BorderBrush="#FF000000" BorderThickness="0.8" CornerRadius="15" Background="MediumSlateBlue" Margin="147,267,540,135">
            <Button Content="Login" HorizontalAlignment="Left" Margin="116,297,0,0" VerticalAlignment="Top" Height="52" Width="167" Click="LoginButton_Click"/>
        </Border>
        <TextBlock HorizontalAlignment="Left" Margin="183,273,0,0" TextWrapping="Wrap" Text="Login" Foreground="White" FontSize="15" FontWeight="Medium" VerticalAlignment="Top" IsHitTestVisible="False" Height="20" Width="42"/>

    </Grid>
</Window>
