<Window x:Class="MortalCombatXClient.LobbyDMScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MortalCombatXClient"
        mc:Ignorable="d"
        Title="LobbyDMScreen" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="MediumSlateBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5A3EBD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4B2FA5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotRoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="MediumSlateBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5A3EBD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4B2FA5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/InLobbywallpaper.jpg"/>
        </Grid.Background>
        <Rectangle HorizontalAlignment="Left" Height="382" Margin="10,21,0,0" Fill="Black" Opacity="0.9" Stroke="Black" VerticalAlignment="Top" Width="380"/>
        <Rectangle HorizontalAlignment="Left" Height="382" Margin="390,21,0,0" Fill="Black" Opacity="0.9" Stroke="Black" VerticalAlignment="Top" Width="400"/>
        <TextBlock x:Name="LobbyNameTitle" HorizontalAlignment="Left" Margin="25,21,0,0" TextWrapping="Wrap" Text="Lobby: (the name)" Foreground="White" FontSize="18" FontWeight="Medium" VerticalAlignment="Top"/>
        <ListBox x:Name="LobbyChatList" Margin="25,45,0,0" Width="499" Height="253" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="PlayersInLobbyList" Margin="584,89,0,0" Width="168" Height="153" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="592,287,0,0" TextWrapping="Wrap" Text="Private Message Selected Player" Foreground="White" FontSize="11" FontWeight="Medium" VerticalAlignment="Top"/>
        <TextBlock x:Name="PlayerCounter" HorizontalAlignment="Left" Margin="584,60,0,0" TextWrapping="Wrap" Text="Player Count: (x/y)" Foreground="White" FontSize="18" FontWeight="Medium" VerticalAlignment="Top"/>
        <TextBox x:Name="InputMessageTextBox" HorizontalAlignment="Left" Margin="25,313,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="400" Height="21"/>
        <ProgressBar x:Name="LoadingBar" Width="120" Height="10" Margin="525,315,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed"/>

        <Button Name="PrivateDMPlayerButton" Content="Message Player" Style="{StaticResource RoundedButtonStyle}" Click="PrivateDMPlayerButton_Click" Margin="605,255,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="126" Height="23"/>
        <Button Name="ShareFileButton" Content="Share" Style="{StaticResource NotRoundButtonStyle}" Click="ShareFileButton_Click" Margin="421,313,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="21" Width="53"/>
        <Button Name="LogoutButton" Content="Logout" Style="{StaticResource RoundedButtonStyle}" Click="LogoutButton_Click" Margin="702,373,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Width="82"/>
        <Button Name="ReturnToLobbyScreen" Content="Return" Style="{StaticResource RoundedButtonStyle}" Click="ReturnButton_Click" Margin="17,373,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Width="82"/>
        <Button x:Name="SendMessageInLobbyButton" Content="Send" Style="{StaticResource NotRoundButtonStyle}" Click="SendMessageInLobbyButton_Click" Margin="471,313,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="21" Width="53"/>
    </Grid>
</Window>
